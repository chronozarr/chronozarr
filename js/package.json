{
  "name": "chronozarr",
  "version": "0.5.0-dev.0",
  "description": "Read chronozarr v0.3 and v0.4 stores in the browser and Node, draw them on MapLibre GL JS, and self-host the chronozarr viewer",
  "homepage": "https://chronozarr.org/reference/javascript",
  "keywords": [
    "chronozarr",
    "zarr",
    "zarr-v3",
    "sharding",
    "raster",
    "geospatial",
    "earth-observation",
    "time-series",
    "sentinel-2",
    "webgl",
    "maplibre",
    "maplibre-gl",
    "custom-layer"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chronozarr/chronozarr.git",
    "directory": "js"
  },
  "type": "module",
  "bin": {
    "chronozarr-viewer": "./support/viewer-bundle.mjs"
  },
  "exports": {
    ".": "./chronozarr/decoder.js",
    "./maplibre": "./maplibre/layer.js",
    "./decode-worker": "./chronozarr/decode-worker.js",
    "./package.json": "./package.json",
    "./geolibre": "./geolibre/plugin.js"
  },
  "files": [
    "chronozarr/",
    "maplibre/layer.js",
    "maplibre/mesh.js",
    "maplibre/projection.js",
    "maplibre/shader.js",
    "maplibre/slots.js",
    "maplibre/view.js",
    "demo/",
    "shared/",
    "favicon.svg",
    "support/viewer-bundle.mjs",
    "vendor/gifenc.esm.js",
    "vendor/numcodecs/",
    "vendor/proj4/",
    "vendor/zarrita/",
    "vendor/zarrita-storage/",
    "geolibre/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node support/check-pack.mjs",
    "pretest": "node e2e/make-node-fixtures.mjs",
    "test": "node --test \"test/*.test.js\"",
    "pretest:coverage": "node e2e/make-node-fixtures.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=chronozarr/** --test-coverage-include=shared/** --test-coverage-include=maplibre/** --test-coverage-include=demo/** --test \"test/*.test.js\"",
    "test:browser": "playwright test",
    "test:package": "node support/check-viewer-package.mjs",
    "vendor": "node support/vendor.mjs",
    "vendor:check": "node support/vendor.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "proj4": "2.22.0",
    "zarrita": "0.7.5"
  }
}
